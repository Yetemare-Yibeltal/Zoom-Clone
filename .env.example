# Application configuration
NODE_ENV=development

# Original Express/EJS prototype
LEGACY_PORT=3000

# Modern API
API_PORT=4000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3001

# Modern web application
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://zoom_user:change_me@localhost:5432/zoom_clone

# LiveKit SFU
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=replace_with_local_development_key
LIVEKIT_API_SECRET=replace_with_local_development_secret
