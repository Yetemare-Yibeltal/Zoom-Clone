{
  "name": "zoom-clone-platform",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack video conferencing platform",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@zoom-clone/web",
    "dev:api": "npm run dev --workspace=@zoom-clone/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "legacy": "nodemon Server-Side/server.js"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "nodemon": "^3.1.10",
    "peer": "^1.0.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^8.3.2"
  }
}
